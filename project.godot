; Engine configuration file.
; Godot 4.3+ — Blockyard diner tycoon, mobile / iOS first.
config_version=5

[application]
config/name="Blockyard"
config/description="Isometric restaurant tycoon. Codigames-style dollhouse diner."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]
Session="*res://scripts/session.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.227, 0.431, 0.51, 1)

[android]
arch/arm64=true

[iphone]
app/min_ios_version="15.0"
